---
import BaseLayout from "../layouts/BaseLayout.astro";
import { merchRunPage, merchSections } from "../content/merchRun";
import { inkFor, PALETTE } from "../content/palette";

// A hidden page: not in the menu, and "Off" most of the year (see
// src/content/pages.ts), when visitors get the closed message below instead.

// Colors cycle through the palette item by item across the whole catalog,
// like the Project Gallery's cards.
let n = 0;
const sections = merchSections.map((s) => ({
  ...s,
  id: "merch-" + s.name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, ""),
  items: s.items.map((item) => {
    const accent = PALETTE[n++ % PALETTE.length];
    return { ...item, accent, ink: inkFor(accent), hasImage: !!item.image?.trim() };
  }),
}));
const named = sections.filter((s) => s.name);

const info = [
  ["When", merchRunPage.when],
  ["Where", merchRunPage.where],
  ["How to pay", merchRunPage.payment],
].filter(([, value]) => value?.trim());
---

<BaseLayout
  title={merchRunPage.heading}
  description="The Wide Tim Merch Run: a pop-up merch shop, a few days a year."
>
  <Fragment slot="closed">
    <h1>{merchRunPage.closedHeading}</h1>
    {merchRunPage.closedText && <p set:html={merchRunPage.closedText} />}
  </Fragment>

  <h1>{merchRunPage.heading}</h1>
  {merchRunPage.intro && <p class="intro">{merchRunPage.intro}</p>}

  {
    info.length > 0 && (
      <dl class="info">
        {info.map(([label, value]) => (
          <div>
            <dt>{label}</dt>
            <dd>{value}</dd>
          </div>
        ))}
      </dl>
    )
  }

  {/* Jump links, for flipping between sections on a phone at the table. */}
  {
    named.length > 1 && (
      <nav class="jump" aria-label="Catalog sections">
        {named.map((s) => (
          <a href={`#${s.id}`}>{s.name}</a>
        ))}
      </nav>
    )
  }

  {sections.length === 0 && <p class="empty">The catalog is on its way.</p>}

  {
    sections.map((s) => (
      <section class="catalog-section" id={s.name ? s.id : undefined} aria-label={s.name || undefined}>
        {s.name && <h2 class="section-title">{s.name}</h2>}
        <ul class="catalog">
          {s.items.map((item) => (
            <li>
              <article
                class={`item${item.soldOut ? " sold-out" : ""}`}
                style={`--item-accent: ${item.accent}; --item-ink: ${item.ink}`}
              >
                <div class="item-photo">
                  {item.hasImage ? (
                    <img src={item.image} alt={item.imageAlt ?? item.name} loading="lazy" decoding="async" />
                  ) : (
                    <span class="item-photo-name" aria-hidden="true">
                      {item.name}
                    </span>
                  )}
                  {item.soldOut && <span class="sold-out-badge">Sold out</span>}
                </div>
                <div class="item-body">
                  <h3 class="item-name">{item.name}</h3>
                  <div class="item-price">
                    {item.soldOut ? <s>{item.price}</s> : item.price}
                  </div>
                  {item.description && <p class="item-desc">{item.description}</p>}
                  {item.options && item.options.length > 0 && (
                    <ul class="options" aria-label="Options">
                      {item.options.map((o) => (
                        <li>{o}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </article>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<style>
  .intro {
    color: var(--fg-body);
    font-size: 1.1rem;
    margin-bottom: 1.5rem;
  }

  /* ---- WHEN / WHERE / HOW TO PAY ---- */
  .info {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2.5rem;
    margin: 0 0 1.75rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
  }
  .info dt {
    font-family: var(--font-display);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--fg-muted);
  }
  .info dd {
    margin: 0;
    font-weight: 600;
    color: var(--fg);
  }

  /* ---- JUMP LINKS ---- */
  .jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .jump a {
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-family: var(--font-display);
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--fg);
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .jump a:hover {
    background: var(--bg-hover);
    border-color: var(--fg);
    color: var(--fg);
  }

  .empty {
    color: var(--fg-muted);
  }

  /* ---- CATALOG ---- */
  .catalog-section {
    scroll-margin-top: 1rem;
  }
  .section-title {
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin: 2rem 0 1rem;
  }
  .catalog {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
  }
  .section-title + .catalog {
    margin-top: 0;
  }

  .item {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  /* Square photo on the item's accent color, which shows around photos
     with transparent backgrounds. No photo: the name, big, on the color. */
  .item-photo {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--item-accent);
    display: grid;
    place-items: center;
  }
  .item-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .item-photo-name {
    padding: 1.25rem;
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.03em;
    text-align: center;
    color: #1a1a1a;
  }

  .item-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 0.9rem 1rem 1.1rem;
  }
  .item-name {
    margin: 0;
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--fg);
  }
  .item-price {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--item-ink);
  }
  .item-desc {
    margin: 0.3rem 0 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--fg-body);
  }
  .options {
    list-style: none;
    padding: 0;
    margin: 0.5rem 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .options li {
    padding: 0.05rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.82rem;
    color: var(--fg-body);
  }

  /* Sold out: faded, with a badge over the photo and the price struck. */
  .sold-out .item-photo {
    background: #9a958d;
  }
  .sold-out .item-photo > :not(.sold-out-badge) {
    opacity: 0.55;
    filter: grayscale(1);
  }
  .sold-out .item-price {
    color: var(--fg-muted);
  }
  .sold-out-badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    padding: 0.2rem 0.75rem;
    border-radius: 999px;
    background: #1a1a1a;
    color: #f4efe6;
    font-family: var(--font-display);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  /* Phones: two items across, so more of the catalog fits on screen. */
  @media (max-width: 600px) {
    .info {
      gap: 0.6rem 1.5rem;
      padding: 0.8rem 1rem;
    }
    .catalog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .item-photo-name {
      padding: 0.75rem;
      font-size: 1.1rem;
    }
    .item-body {
      padding: 0.65rem 0.7rem 0.8rem;
    }
    .item-name {
      font-size: 0.98rem;
    }
    .item-price {
      font-size: 1.05rem;
    }
    .item-desc {
      font-size: 0.85rem;
    }
    .options li {
      font-size: 0.76rem;
      padding: 0.05rem 0.5rem;
    }
    .sold-out-badge {
      top: 0.5rem;
      left: 0.5rem;
      font-size: 0.75rem;
      padding: 0.15rem 0.6rem;
    }
  }
</style>
