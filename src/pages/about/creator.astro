---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PlaceholderImage from "../../components/PlaceholderImage.astro";
import { aboutCreator } from "../../content/aboutCreator";
---

<BaseLayout
  title={aboutCreator.heading}
  description="About Margaret Zheng (MIT '23, MEng '24), the artist and creator behind Wide Tim."
>
  <div class="creator-layout">
    <div class="profile">
      <h1>{aboutCreator.heading}</h1>

      <PlaceholderImage
        src={aboutCreator.image}
        alt={aboutCreator.imageAlt}
        label="About the Creator — image placeholder"
        aspectRatio="1118 / 794"
      />

      <div class="profile-info">
        <h2 class="name">
          <span>{aboutCreator.name}</span><span class="name-sep" aria-hidden="true"> | </span><span class="name-zh" lang="zh-Hans">{aboutCreator.chineseName}</span>
        </h2>

        <ul class="facts">
          {aboutCreator.facts.map((f) => <li>{f}</li>)}
        </ul>

        <ul class="links">
          {
            aboutCreator.links.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener noreferrer">
                  <span class="link-label">{l.label}</span>
                  {l.handle}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="bio">
      {aboutCreator.paragraphs.map((p) => <p set:html={p} />)}
    </div>
  </div>
</BaseLayout>

<style>
  /* Heading, photo, name and facts on the left, bio on the right, with the
     bio's first line level with the heading. Putting the name and facts
     under the photo (instead of beside it) keeps the two columns about the
     same height, so there's no empty space under the photo, and the bio
     starts near the top of the page. */
  .creator-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 3rem;
    align-items: start;
  }

  .profile {
    /* Lets the name decide whether it fits on one line (see below). */
    container-type: inline-size;
  }
  .profile :global(img),
  .profile :global(.placeholder-img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 8px;
  }

  .profile-info {
    padding-top: 1.35rem;
  }

  .name {
    font-size: 1.6rem;
    margin: 0 0 0.6rem;
  }
  /* When the column is too narrow for the whole name on one line, put the
     Chinese name on its own line and drop the "|" instead of letting the
     line wrap in the middle. */
  @container (max-width: 400px) {
    .name-sep {
      display: none;
    }
    .name-zh {
      display: block;
      margin-top: 0.15rem;
    }
  }

  .facts,
  .links {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .facts li {
    color: var(--fg-muted);
    padding: 0.1rem 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.1rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  /* Pill links — same shape as the nav's theme button. */
  .links a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.3rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.95rem;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease, color 0.15s ease;
  }
  .links a:hover {
    border-color: #f08066;
    background: var(--bg-hover);
    color: var(--fg);
  }
  .link-label {
    font-family: var(--font-display);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8rem;
    color: var(--fg-muted);
  }

  .bio {
    color: var(--fg-body);
    line-height: 1.75;
    /* Nudges the first line down so its letters start level with the
       heading's. The heading's letters sit about 0.28em into its line box,
       and its size scales with 5vw (see global h1), so the nudge does too. */
    padding-top: clamp(0.1rem, 1.4vw - 0.55rem, 0.36rem);
  }
  .bio p:last-child {
    margin-bottom: 0;
  }

  /* Stack on narrow screens: photo first, capped so it doesn't dominate. */
  @media (max-width: 760px) {
    .creator-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .profile {
      max-width: 520px;
    }
  }
</style>
